 357          void ISR_Ures(void) interrupt 0
 358          {
 359   1         // whenever we get a USB reset, we should revert to full speed mode
 360   1         pConfigDscr = pFullSpeedConfigDscr;
 361   1         ((CONFIGDSCR xdata *) pConfigDscr)->type = CONFIG_DSCR;
 362   1         pOtherConfigDscr = pHighSpeedConfigDscr;
 363   1         ((CONFIGDSCR xdata *) pOtherConfigDscr)->type = OTHERSPEED_DSCR;
 364   1      
 365   1         EZUSB_IRQ_CLEAR();
C51 COMPILER V7.20   FX2HID                                                                05/16/2023 10:18:57 PAGE 7   

 366   1         USBIRQ = bmURES;         // Clear URES IRQ
