 110          
 111          void TD_Init(void)             // Called once at startup
 112          {
 113   1         // set the CPU clock to 48MHz
 114   1         CPUCS = ((CPUCS & ~bmCLKSPD) | bmCLKSPD1) ;
 115   1      
 116   1         // set the slave FIFO interface to 48MHz
 117   1         IFCONFIG |= 0x40;
C51 COMPILER V7.20   FX2HID                                                                05/16/2023 10:18:57 PAGE 3   

 118   1      
 119   1        // Registers which require a synchronization delay, see section 15.14
 120   1        // FIFORESET        FIFOPINPOLAR
 121   1        // INPKTEND         OUTPKTEND
 122   1        // EPxBCH:L         REVCTL
 123   1        // GPIFTCB3         GPIFTCB2
 124   1        // GPIFTCB1         GPIFTCB0
 125   1        // EPxFIFOPFH:L     EPxAUTOINLENH:L
 126   1        // EPxFIFOCFG       EPxGPIFFLGSEL
 127   1        // PINFLAGSxx       EPxFIFOIRQ
 128   1        // EPxFIFOIE        GPIFIRQ
 129   1        // GPIFIE           GPIFADRH:L
 130   1        // UDMACRCH:L       EPxGPIFTRIG
 131   1        // GPIFTRIG
 132   1        
 133   1        // Note: The pre-REVE EPxGPIFTCH/L register are affected, as well...
 134   1        //      ...these have been replaced by GPIFTC[B3:B0] registers
 135   1      
 136   1        // default: all endpoints have their VALID bit set
 137   1        // default: TYPE1 = 1 and TYPE0 = 0 --> BULK  
 138   1        // default: EP2 and EP4 DIR bits are 0 (OUT direction)
 139   1        // default: EP6 and EP8 DIR bits are 1 (IN direction)
 140   1        // default: EP2, EP4, EP6, and EP8 are double buffered
 141   1      
 142   1        // we are just using the default values, yes this is not necessary...
 143   1        EP1OUTCFG = 0xA0;
 144   1        EP1INCFG = 0xA0;
 145   1        SYNCDELAY;                    // see TRM section 15.14
 146   1        EP2CFG = 0xA2;
 147   1        SYNCDELAY;                    
 148   1        EP4CFG = 0xA0;
 149   1        SYNCDELAY;                    
 150   1        EP6CFG = 0xE2;
 151   1        SYNCDELAY;                    
 152   1        EP8CFG = 0xE0;
 153   1      
 154   1        // out endpoints do not come up armed
 155   1        
 156   1        // since the defaults are double buffered we must write dummy byte counts twice
 157   1        SYNCDELAY;                    
 158   1        EP2BCL = 0x80;                // arm EP2OUT by writing byte count w/skip.
 159   1        SYNCDELAY;                    
 160   1        EP2BCL = 0x80;
 161   1        SYNCDELAY;                    
 162   1        EP4BCL = 0x80;                // arm EP4OUT by writing byte count w/skip.
 163   1        SYNCDELAY;                    
 164   1        EP4BCL = 0x80;    
 165   1      
 166   1        // enable dual autopointer feature
 167   1        AUTOPTRSETUP |= 0x01;
 168   1      
 169   1        Rwuen = TRUE;                 // Enable remote-wakeup
 170   1      
 171   1      }
