 186   2                              {
 187   2                                      if (buttons & 1)        //Shift
 188   2                                              EP1INBUF[0] = 0;
 189   2                                      else
 190   2                                              EP1INBUF[0] = 2;
 191   2                                      if (buttons & 2)        //a
 192   2                                              EP1INBUF[2] = 0;
 193   2                                      else
