 306          BOOL DR_VendorCmnd(void)
 307          {
 308   1        BYTE tmp;
 309   1        
 310   1        switch (SETUPDAT[1])
 311   1        {
 312   2           case VR_NAKALL_ON:
 313   2              tmp = FIFORESET;
 314   2              tmp |= bmNAKALL;      
 315   2              SYNCDELAY;                    
 316   2              FIFORESET = tmp;
 317   2              break;
 318   2           case VR_NAKALL_OFF:
 319   2              tmp = FIFORESET;
 320   2              tmp &= ~bmNAKALL;      
 321   2              SYNCDELAY;                    
 322   2              FIFORESET = tmp;
 323   2              break;
 324   2           default:
 325   2              return(TRUE);
 326   2        }
 327   1      
 328   1        return(FALSE);
 329   1      }
