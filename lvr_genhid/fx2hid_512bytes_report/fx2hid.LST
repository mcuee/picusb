 174          void TD_Poll(void)              // Called repeatedly while the device is idle
 175          {
 176   1              if( !(EP1INCS & 0x02) ) // Is the EP1INBUF available,
 177   1              {
 178   2      
 179   2      //              This keyboard code is unneeded
