 209   2              }
 210   1              if( !(EP1OUTCS & 0x02) )        // Is there something available in EP1OUTBUF
 211   1              {
 212   2      
 213   2      //              This keyboard code is unneeded by usbhidio
 214   2      /*
 215   2                      leds = 0xFF;    //Turn all off
 216   2                      if (EP1OUTBUF[0] & 0x02)        //Caps
 217   2                              leds &= 0xBF;
 218   2                      if (EP1OUTBUF[0] & 0x01)        //Scroll
 219   2                              leds &= 0xF7;
 220   2                      if (EP1OUTBUF[0] & 0x04)        //Num
 221   2                              leds &= 0xFE;
 222   2                      write_leds (leds);
 223   2      */
 224   2      
 225   2      // usbhidio code start
 226   2      
 227   2      // Copy bytes received on the OUT endpoint to the IN endpoint. 
 228   2                      for (i =0; i< 64; i++) {
 229   3                              EP1INBUF[i] = EP1OUTBUF[i];
 230   3                      }
 231   2      
 232   2      // Rearm the IN endpoint buffer to enable sending a report.
 233   2      // The value equals the report size.
 234   2                      EP1INBC = 64;                   
 235   2      
 236   2      // usbhidiocode end
 237   2      
 238   2                      EP1OUTBC = 0;                           //Rearm the OUT endpoint buffer to enable receiving a report.
 239   2      
 240   2              } 
 241   1      }
