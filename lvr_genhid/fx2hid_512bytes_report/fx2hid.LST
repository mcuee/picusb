 375          
 376          void ISR_Highspeed(void) interrupt 0
 377          {
 378   1         if (EZUSB_HIGHSPEED())
 379   1         {
 380   2            pConfigDscr = pHighSpeedConfigDscr;
 381   2            ((CONFIGDSCR xdata *) pConfigDscr)->type = CONFIG_DSCR;
 382   2            pOtherConfigDscr = pFullSpeedConfigDscr;
 383   2            ((CONFIGDSCR xdata *) pOtherConfigDscr)->type = OTHERSPEED_DSCR;
 384   2         }
 385   1      
 386   1         EZUSB_IRQ_CLEAR();
 387   1         USBIRQ = bmHSGRANT;
 388   1      }
