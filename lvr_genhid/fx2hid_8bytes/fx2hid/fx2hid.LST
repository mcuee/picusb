 309          BOOL DR_VendorCmnd(void)
 310          {
 311   1        BYTE tmp;
 312   1        
 313   1        switch (SETUPDAT[1])
 314   1        {
 315   2           case VR_NAKALL_ON:
 316   2              tmp = FIFORESET;
 317   2              tmp |= bmNAKALL;      
 318   2              SYNCDELAY;                    
 319   2              FIFORESET = tmp;
 320   2              break;
 321   2           case VR_NAKALL_OFF:
 322   2              tmp = FIFORESET;
 323   2              tmp &= ~bmNAKALL;      
 324   2              SYNCDELAY;                    
 325   2              FIFORESET = tmp;
 326   2              break;
 327   2           default:
 328   2              return(TRUE);
 329   2        }
 330   1      
 331   1        return(FALSE);
 332   1      }
