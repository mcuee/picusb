 172          void TD_Poll(void)              // Called repeatedly while the device is idle
 173          {
 174   1              if( !(EP1INCS & 0x02) ) // Is the EP1INBUF available,
 175   1              {
 176   2      
 177   2      //              This keyboard code is unneeded
 178   2      /*      
 179   2              buttons = read_buttons();
C51 COMPILER V7.07   FX2HID                                                                05/14/2023 21:16:31 PAGE 4   

 180   2                      if (buttons == read_buttons())  //Debounce
 181   2                      {
 182   2                              buttons &= 0x0F;
 183   2                              if ((oldbuttons - buttons) != 0)        //Change in button state
 184   2                              {
 185   2                                      if (buttons & 1)        //Shift
 186   2                                              EP1INBUF[0] = 0;
 187   2                                      else
 188   2                                              EP1INBUF[0] = 2;
 189   2                                      if (buttons & 2)        //a
 190   2                                              EP1INBUF[2] = 0;
 191   2                                      else
 192   2                                              EP1INBUF[2] = 4;
 193   2                                      if (buttons & 4)        //b
 194   2                                              EP1INBUF[3] = 0;
 195   2                                      else
 196   2                                              EP1INBUF[3] = 5;
 197   2                                      if (buttons & 8)        //c
 198   2                                              EP1INBUF[4] = 0;
 199   2                                      else
 200   2                                              EP1INBUF[4] = 6;
 201   2                                      EP1INBUF[1] = 0;
 202   2                                      EP1INBC = 5;
 203   2                              }
 204   2                              oldbuttons = buttons;
 205   2                      }
 206   2      */
 207   2              }
 208   1              if( !(EP1OUTCS & 0x02) )        // Is there something available in EP1OUTBUF
 209   1              {
 210   2      
 211   2      //              This keyboard code is unneeded by usbhidio
 212   2      /*
 213   2                      leds = 0xFF;    //Turn all off
 214   2                      if (EP1OUTBUF[0] & 0x02)        //Caps
 215   2                              leds &= 0xBF;
 216   2                      if (EP1OUTBUF[0] & 0x01)        //Scroll
 217   2                              leds &= 0xF7;
 218   2                      if (EP1OUTBUF[0] & 0x04)        //Num
 219   2                              leds &= 0xFE;
 220   2                      write_leds (leds);
 221   2      */
 222   2      
 223   2      // usbhidio code start
 224   2      
 225   2      // Copy bytes received on the OUT endpoint to the IN endpoint. 
 226   2                      EP1INBUF[0] = EP1OUTBUF[0];
 227   2                      EP1INBUF[1] = EP1OUTBUF[1];
 228   2                      EP1INBUF[2] = EP1OUTBUF[2];
 229   2                      EP1INBUF[3] = EP1OUTBUF[3];
 230   2                      EP1INBUF[4] = EP1OUTBUF[4];
 231   2                      EP1INBUF[5] = EP1OUTBUF[5];
 232   2                      EP1INBUF[6] = EP1OUTBUF[6];
 233   2                      EP1INBUF[7] = EP1OUTBUF[7];
 234   2      
 235   2      // Rearm the IN endpoint buffer to enable sending a report.
 236   2      // The value equals the report size.
 237   2                      EP1INBC = 8;                    
 238   2      
 239   2      // usbhidiocode end
 240   2      
 241   2                      EP1OUTBC = 0;                           //Rearm the OUT endpoint buffer to enable receiving a report.
C51 COMPILER V7.07   FX2HID                                                                05/14/2023 21:16:31 PAGE 5   

 242   2      
 243   2              } 
 244   1      }
