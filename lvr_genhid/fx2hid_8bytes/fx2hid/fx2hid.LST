 338          
 339          // Setup Data Available Interrupt Handler
 340          void ISR_Sudav(void) interrupt 0
 341          {
 342   1         GotSUD = TRUE;            // Set flag
 343   1         EZUSB_IRQ_CLEAR();
 344   1         USBIRQ = bmSUDAV;         // Clear SUDAV IRQ
 345   1      }
 346          
 347          // Setup Token Interrupt Handler
 348          void ISR_Sutok(void) interrupt 0
 349          {
 350   1         EZUSB_IRQ_CLEAR();
 351   1         USBIRQ = bmSUTOK;         // Clear SUTOK IRQ
 352   1      }
 353          
 354          void ISR_Sof(void) interrupt 0
 355          {
 356   1         EZUSB_IRQ_CLEAR();
 357   1         USBIRQ = bmSOF;            // Clear SOF IRQ
 358   1      }
 359          
 360          void ISR_Ures(void) interrupt 0
 361          {
 362   1         // whenever we get a USB reset, we should revert to full speed mode
 363   1         pConfigDscr = pFullSpeedConfigDscr;
 364   1         ((CONFIGDSCR xdata *) pConfigDscr)->type = CONFIG_DSCR;
 365   1         pOtherConfigDscr = pHighSpeedConfigDscr;
C51 COMPILER V7.07   FX2HID                                                                05/14/2023 21:16:31 PAGE 7   

 366   1         ((CONFIGDSCR xdata *) pOtherConfigDscr)->type = OTHERSPEED_DSCR;
 367   1      
 368   1         EZUSB_IRQ_CLEAR();
 369   1         USBIRQ = bmURES;         // Clear URES IRQ
 370   1      }
 371          
 372          void ISR_Susp(void) interrupt 0
 373          {
 374   1         Sleep = TRUE;
 375   1         EZUSB_IRQ_CLEAR();
 376   1         USBIRQ = bmSUSP;
 377   1      }
 378          
 379          void ISR_Highspeed(void) interrupt 0
 380          {
 381   1         if (EZUSB_HIGHSPEED())
 382   1         {
 383   2            pConfigDscr = pHighSpeedConfigDscr;
 384   2            ((CONFIGDSCR xdata *) pConfigDscr)->type = CONFIG_DSCR;
 385   2            pOtherConfigDscr = pFullSpeedConfigDscr;
 386   2            ((CONFIGDSCR xdata *) pOtherConfigDscr)->type = OTHERSPEED_DSCR;
 387   2         }
 388   1      
 389   1         EZUSB_IRQ_CLEAR();
 390   1         USBIRQ = bmHSGRANT;
 391   1      }
