  94          void TD_Poll(void)              // Called repeatedly while the device is idle
  95          {
  96   1        WORD i;
  97   1        WORD count;
  98   1      
  99   1        if(!(EP2468STAT & bmEP2EMPTY))
 100   1        { // check EP2 EMPTY(busy) bit in EP2468STAT (SFR), core set's this bit when FIFO is empty
 101   2           if(!(EP2468STAT & bmEP6FULL))
 102   2           {  // check EP6 FULL(busy) bit in EP2468STAT (SFR), core set's this bit when FIFO is full
 103   3              APTR1H = MSB( &EP2FIFOBUF );
 104   3              APTR1L = LSB( &EP2FIFOBUF );
 105   3      
 106   3              AUTOPTRH2 = MSB( &EP6FIFOBUF );
 107   3              AUTOPTRL2 = LSB( &EP6FIFOBUF );
 108   3      
 109   3              count = (EP2BCH << 8) + EP2BCL;
 110   3      
 111   3              // loop EP2OUT buffer data to EP6IN
 112   3              for( i = 0x0000; i < count; i++ )
 113   3              {
 114   4                 // setup to transfer EP2OUT buffer to EP6IN buffer using AUTOPOINTER(s)
 115   4                 EXTAUTODAT2 = EXTAUTODAT1;
 116   4              }
 117   3              
C51 COMPILER V7.06   PINGNAK                                                               06/13/2012 13:22:18 PAGE 3   

 118   3              EP6BCH = EP2BCH;  
 119   3              SYNCDELAY;  
 120   3              EP6BCL = EP2BCL;        // arm EP6IN
 121   3              SYNCDELAY;                    
 122   3              EP2BCL = 0x80;          // re(arm) EP2OUT
 123   3           }
 124   2        }
 125   1      
 126   1        if(!(EP2468STAT & bmEP4EMPTY))
 127   1        { // check EP4 EMPTY(busy) bit in EP2468STAT (SFR), core set's this bit when FIFO is empty
 128   2           if(!(EP2468STAT & bmEP8FULL))
 129   2           {  // check EP8 FULL(busy) bit in EP2468STAT (SFR), core set's this bit when FIFO is full
 130   3              APTR1H = MSB( &EP4FIFOBUF );
 131   3              APTR1L = LSB( &EP4FIFOBUF );
 132   3      
 133   3              AUTOPTRH2 = MSB( &EP8FIFOBUF );
 134   3              AUTOPTRL2 = LSB( &EP8FIFOBUF );
 135   3      
 136   3              count = (EP4BCH << 8) + EP4BCL;
 137   3      
 138   3              // loop EP4OUT buffer data to EP8IN
 139   3              for( i = 0x0000; i < count; i++ )
 140   3              {
 141   4                 // setup to transfer EP4OUT buffer to EP8IN buffer using AUTOPOINTER(s)
 142   4                 EXTAUTODAT2 = EXTAUTODAT1;
 143   4              }
 144   3              
 145   3              EP8BCH = EP4BCH;  
 146   3              SYNCDELAY;  
 147   3              EP8BCL = EP4BCL;        // arm EP8IN
 148   3              SYNCDELAY;                    
 149   3              EP4BCL = 0x80;          // re(arm) EP4OUT
 150   3           }
 151   2        }
 152   1      }
