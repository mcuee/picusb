   2          // File:       pingnak.c
   3          // Contents:   firmware to perform bulk loopback of EP2OUT to EP6IN and
   4          //             EP4OUT to EP8IN using the PING NAK interrupt
   5          //             to initiate the transfer.  Use with the cybulk host app.
