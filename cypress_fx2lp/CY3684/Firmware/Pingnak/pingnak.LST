  34          void TD_Init(void)              // Called once at startup
  35          {
  36   1        CPUCS = 0x10;                 // CLKSPD[1:0]=10, for 48MHz operation
  37   1                                      // CLKOE=0, don't drive CLKOUT
  38   1      
  39   1        // Registers which require a synchronization delay, see section 15.14
  40   1        // FIFORESET        FIFOPINPOLAR
  41   1        // INPKTEND         OUTPKTEND
  42   1        // EPxBCH:L         REVCTL
  43   1        // GPIFTCB3         GPIFTCB2
  44   1        // GPIFTCB1         GPIFTCB0
  45   1        // EPxFIFOPFH:L     EPxAUTOINLENH:L
  46   1        // EPxFIFOCFG       EPxGPIFFLGSEL
  47   1        // PINFLAGSxx       EPxFIFOIRQ
  48   1        // EPxFIFOIE        GPIFIRQ
  49   1        // GPIFIE           GPIFADRH:L
  50   1        // UDMACRCH:L       EPxGPIFTRIG
  51   1        // GPIFTRIG
  52   1        
  53   1        // Note: The pre-REVE EPxGPIFTCH/L register are affected, as well...
  54   1        //      ...these have been replaced by GPIFTC[B3:B0] registers
  55   1      
C51 COMPILER V7.06   PINGNAK                                                               06/13/2012 13:22:18 PAGE 2   

  56   1        // default: all endpoints have their VALID bit set
  57   1        // default: TYPE1 = 1 and TYPE0 = 0 --> BULK  
  58   1        // default: EP2 and EP4 DIR bits are 0 (OUT direction)
  59   1        // default: EP6 and EP8 DIR bits are 1 (IN direction)
  60   1        // default: EP2, EP4, EP6, and EP8 are double buffered
  61   1      
  62   1        // we are just using the default values, yes this is not necessary...
  63   1        EP1OUTCFG = 0xA0;
  64   1        EP1INCFG = 0xA0;
  65   1        SYNCDELAY;                    // see TRM section 15.14
  66   1        EP2CFG = 0xA2;
  67   1        SYNCDELAY;                    
  68   1        EP4CFG = 0xA0;
  69   1        SYNCDELAY;                    
  70   1        EP6CFG = 0xE2;
  71   1        SYNCDELAY;                    
  72   1        EP8CFG = 0xE0;
  73   1      
  74   1        // out endpoints do not come up armed
  75   1        
  76   1        // since the defaults are double buffered we must write dummy byte counts twice
  77   1        SYNCDELAY;                    
  78   1        EP2BCL = 0x80;                // arm EP2OUT by writing byte count w/skip.
  79   1        SYNCDELAY;                    
  80   1        EP2BCL = 0x80;
  81   1        SYNCDELAY;                    
  82   1        EP4BCL = 0x80;                // arm EP4OUT by writing byte count w/skip.
  83   1        SYNCDELAY;                    
  84   1        EP4BCL = 0x80;    
  85   1      
  86   1        // enable dual autopointer feature
  87   1        AUTOPTRSETUP |= 0x01;
  88   1      
  89   1        NAKIRQ |= ~bmIBN;                   // clear any pending PING-NAK IRQ
  90   1        NAKIE |= bmEP2PING | bmEP4PING;     // enable the PING-NAK interrupt for EP2 and EP4
  91   1      
  92   1      }
