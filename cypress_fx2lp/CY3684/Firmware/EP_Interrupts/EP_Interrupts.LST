  82   1        
  83   1       
  84   1        EPIE |= bmBIT3 |bmBIT4 | bmBIT5; // Enable EP2, EP4 and EP1 OUT Endpoint interrupts
  85   1        EPIE |= bmBIT6 |bmBIT7 | bmBIT2; // Enable EP6, EP8 and EP1 IN  Endpoint interrupts
  86   1        
  87   1        // enable dual autopointer feature
