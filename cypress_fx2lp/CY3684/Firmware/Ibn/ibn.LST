  99          void TD_Poll(void)              // Called repeatedly while the device is idle
 100          {
 101   1        int i;
 102   1        int byteCount;
 103   1      
 104   1        // if there is new data in EP2FIFOBUF and the IBN flag for EP6 has been set, then copy
 105   1        // the data from EP2 to EP6
 106   1        if(!(EP2468STAT & bmEP2EMPTY) && (IbnFlag & bmEP6IBN) )
 107   1        {
 108   2           APTR1H = MSB( &EP2FIFOBUF );
 109   2           APTR1L = LSB( &EP2FIFOBUF );
 110   2      
 111   2           AUTOPTRH2 = MSB( &EP6FIFOBUF );
 112   2           AUTOPTRL2 = LSB( &EP6FIFOBUF );
 113   2      
 114   2           byteCount = (EP2BCH << 8) + EP2BCL;
 115   2      
 116   2           for( i = 0x0000; i < byteCount; i++ )
 117   2           {
C51 COMPILER V7.06   IBN                                                                   06/13/2012 13:37:15 PAGE 3   

 118   3              EXTAUTODAT2 = EXTAUTODAT1;
 119   3           }
 120   2      
 121   2           EP6BCH = EP2BCH;  
 122   2           SYNCDELAY;  
 123   2           EP6BCL = EP2BCL;           // arm EP6IN
 124   2      
 125   2           IbnFlag &= ~bmEP6IBN;      // clear the IBN flag
 126   2           IBNIRQ = bmEP6IBN;         // clear the IBN IRQ
 127   2           IBNIE |= bmEP6IBN;         // enable the IBN IRQ
 128   2      
 129   2           SYNCDELAY;                        
 130   2           EP2BCL = 0x80;             // re(arm) EP2OUT
 131   2        }
 132   1      
 133   1        // if there is new data in EP4FIFOBUF and the IBN flag for EP8 has been set, then copy
 134   1        // the data from EP2 to EP6
 135   1        if(!(EP2468STAT & bmEP4EMPTY) && (IbnFlag & bmEP8IBN) )
 136   1        {
 137   2           APTR1H = MSB( &EP4FIFOBUF );
 138   2           APTR1L = LSB( &EP4FIFOBUF );
 139   2      
 140   2           AUTOPTRH2 = MSB( &EP8FIFOBUF );
 141   2           AUTOPTRL2 = LSB( &EP8FIFOBUF );
 142   2      
 143   2           byteCount = (EP4BCH << 8) + EP4BCL;
 144   2      
 145   2           for( i = 0x0000; i < byteCount; i++ )
 146   2           {
 147   3              EXTAUTODAT2 = EXTAUTODAT1;
 148   3           }
 149   2      
 150   2           EP8BCH = EP4BCH;  
 151   2           SYNCDELAY;  
 152   2           EP8BCL = EP4BCL;           // arm EP8IN
 153   2      
 154   2           IbnFlag &= ~bmEP8IBN;      // clear the IBN flag
 155   2           IBNIRQ = bmEP8IBN;         // clear the IBN IRQ
 156   2           IBNIE |= bmEP8IBN;         // enable the IBN IRQ
 157   2      
 158   2           SYNCDELAY;                        
 159   2           EP4BCL = 0x80;             // re(arm) EP4OUT
 160   2        }
 161   1      
 162   1      }
