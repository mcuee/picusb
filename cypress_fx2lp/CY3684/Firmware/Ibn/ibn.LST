 328          void ISR_Ibn(void) interrupt 0
 329          {
 330   1         int i;
 331   1      
 332   1         // disable IBN for all endpoints
 333   1         IBNIE = 0x00;
 334   1      
 335   1         EZUSB_IRQ_CLEAR();         // clear the global USB IRQ
 336   1      
 337   1         // Find the EP with its IBN bit set
 338   1         for (i=0;i<8;i++)
 339   1         {
 340   2            if (IBNIRQ & (1 << i))
 341   2            {
 342   3               IbnFlag |= (1 << i);       // set the appropriate IBN flag bit
 343   3               IBNIRQ |= (1 << i);        // clear the IBN IRQ for this endpoint
 344   3            }
 345   2         }
 346   1      
 347   1         NAKIRQ |= bmBIT0;          // clear the global IBN IRQ
 348   1      
 349   1         // re-enable IBN interrupt for any endpoints that don't already have
 350   1         // an IBN pending in IbnFlag
 351   1         IBNIE = (bmEP6IBN | bmEP8IBN) & ~IbnFlag;
 352   1      }
