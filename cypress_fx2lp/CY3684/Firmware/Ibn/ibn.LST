  35          void TD_Init(void)              // Called once at startup
  36          {
  37   1        CPUCS = 0x10;                 // CLKSPD[1:0]=10, for 48MHz operation
  38   1                                      // CLKOE=0, don't drive CLKOUT
  39   1      
  40   1        // Registers which require a synchronization delay, see section 15.14
  41   1        // FIFORESET        FIFOPINPOLAR
  42   1        // INPKTEND         OUTPKTEND
  43   1        // EPxBCH:L         REVCTL
  44   1        // GPIFTCB3         GPIFTCB2
  45   1        // GPIFTCB1         GPIFTCB0
  46   1        // EPxFIFOPFH:L     EPxAUTOINLENH:L
  47   1        // EPxFIFOCFG       EPxGPIFFLGSEL
  48   1        // PINFLAGSxx       EPxFIFOIRQ
  49   1        // EPxFIFOIE        GPIFIRQ
  50   1        // GPIFIE           GPIFADRH:L
  51   1        // UDMACRCH:L       EPxGPIFTRIG
  52   1        // GPIFTRIG
  53   1        
  54   1        // Note: The pre-REVE EPxGPIFTCH/L register are affected, as well...
  55   1        //      ...these have been replaced by GPIFTC[B3:B0] registers
C51 COMPILER V7.06   IBN                                                                   06/13/2012 13:37:15 PAGE 2   

  56   1        
  57   1        // default: all endpoints have their VALID bit set
  58   1        // default: TYPE1 = 1 and TYPE0 = 0 --> BULK  
  59   1        // default: EP2 and EP4 DIR bits are 0 (OUT direction)
  60   1        // default: EP6 and EP8 DIR bits are 1 (IN direction)
  61   1        // default: EP2, EP4, EP6, and EP8 are double buffered
  62   1      
  63   1        // we are just using the default values, yes this is not necessary...
  64   1        EP1OUTCFG = 0xA0;
  65   1        EP1INCFG = 0xA0;
  66   1        SYNCDELAY;                    // see TRM section 15.14
  67   1        EP2CFG = 0xA2;
  68   1        SYNCDELAY;                    // 
  69   1        EP4CFG = 0xA0;
  70   1        SYNCDELAY;                    // 
  71   1        EP6CFG = 0xE2;
  72   1        SYNCDELAY;                    // 
  73   1        EP8CFG = 0xE0;
  74   1      
  75   1        // out endpoints do not come up armed
  76   1        
  77   1        // since the defaults are double buffered we must write dummy byte counts twice
  78   1        SYNCDELAY;                    // 
  79   1        EP2BCL = 0x80;                // arm EP2OUT by writing byte count w/skip.
  80   1        SYNCDELAY;                    // 
  81   1        EP4BCL = 0x80;    
  82   1        SYNCDELAY;                    // 
  83   1        EP2BCL = 0x80;                // arm EP4OUT by writing byte count w/skip.
  84   1        SYNCDELAY;                    // 
  85   1        EP4BCL = 0x80;    
  86   1      
  87   1        NAKIRQ = bmBIT0;              // clear the global IBN IRQ
  88   1        NAKIE |= bmBIT0;              // enable the global IBN IRQ
  89   1      
  90   1        IbnFlag = 0x00;               // clear our IBN flag
  91   1        IBNIRQ = 0xFF;                // clear any pending IBN IRQ
  92   1        IBNIE |= bmEP6IBN | bmEP8IBN; // enable the IBN interrupt for EP6 and EP8
  93   1      
  94   1        // enable dual autopointer feature
  95   1        AUTOPTRSETUP |= 0x01;
  96   1      
  97   1      }
