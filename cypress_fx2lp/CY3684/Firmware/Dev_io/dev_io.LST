 111          void I2C_WriteByte(BYTE I2CAddr, BYTE dat)
 112          {
 113   1          // wait for STOP
 114   1          while (I2CS & bmSTOP);
 115   1      
 116   1          // set the START bit and write the address
C51 COMPILER V7.06   DEV_IO                                                                06/13/2012 13:34:05 PAGE 3   

 117   1          I2CS = bmSTART;
 118   1          I2DAT = I2CAddr << 1;
 119   1      
 120   1          // wait for done
 121   1          while (!(I2CS & bmDONE));
 122   1          
 123   1          // write the requested data
 124   1          I2DAT = dat;
 125   1      
 126   1          // wait for done
 127   1          while (!(I2CS & bmDONE));
 128   1      
 129   1          // set the STOP bit    
 130   1          I2CS = bmSTOP;
 131   1      }
 132          
 133          BYTE I2C_ReadByte(BYTE I2CAddr)
 134          {
 135   1          BYTE retval;
 136   1      
 137   1          // wait for STOP
 138   1          while (I2CS & bmSTOP);
 139   1      
 140   1          // set the START bit and write the address
 141   1          I2CS = bmSTART;
 142   1          I2DAT = (I2CAddr << 1) | 0x01;
 143   1      
 144   1          // wait for done
 145   1          while (!(I2CS & bmDONE));
 146   1      
 147   1          // check for ACK, return 0 if no response
 148   1          if (!(I2CS & bmACK))
 149   1          {
 150   2              I2CS = bmSTOP;
 151   2              retval = 0;
 152   2          }
 153   1          else
 154   1          {
 155   2              // read the dummy byte
 156   2              retval = I2DAT;
 157   2              I2CS = bmLASTRD;
 158   2      
 159   2              while (!(I2CS & bmDONE));
 160   2              I2CS = bmSTOP;
 161   2      
 162   2              retval = I2DAT;
 163   2          }
 164   1      
 165   1          return(retval);
 166   1      }
