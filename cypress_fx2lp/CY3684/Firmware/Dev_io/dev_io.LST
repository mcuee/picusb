   1          //-----------------------------------------------------------------------------
   2          //   File:      devio.c
   3          //   Contents:  main module of a simple non-renumerating firmware example
   4          //
   5          // The purpose of this software is to demonstrate how
   6          // to use the buttons and LED on the EZ-USB developer's
   7          // kit.
   8          // 
   9          // The device I/O example program uses the LED on the Development board
  10          // to display a running application program on the EZ-USB chip.
  11          // The buttons on the development board may be pressed to count up (F3),
  12          // count down (F2), and reset the seven segment LED to "0" (F1) or "F" (F4).
  13          // The code is written in C and uses several EZ-USB library functions.  
  14          // It does not use the FrameWorks. 
  15          //
  16          // $Archive: /USB/Examples/FX2LP/dev_io/dev_io.c $
