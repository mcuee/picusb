 145          //-----------------------------------------------------------------------------
 146          // Device Request hooks
 147          //   The following hooks are called by the end point 0 device request parser.
 148          //-----------------------------------------------------------------------------
 149          
 150          BOOL DR_GetDescriptor(void)
 151          {
 152   1              BYTE length,i;
 153   1      
 154   1              pHIDDscr = (WORD)&HIDDscr;
 155   1              pReportDscr = (WORD)&HIDReportDscr;
 156   1              pReportDscrEnd = (WORD)&HIDReportDscrEnd;
 157   1      
 158   1              switch (SETUPDAT[3])
 159   1              {
 160   2                      case GD_HID:                                    //HID Descriptor
 161   2                              SUDPTRH = MSB(pHIDDscr);
 162   2                              SUDPTRL = LSB(pHIDDscr);
 163   2                              return (FALSE);
 164   2                      case GD_REPORT:                                 //Report Descriptor
 165   2                              length = pReportDscrEnd - pReportDscr;
 166   2      
 167   2               AUTOPTR1H = MSB(pReportDscr);
 168   2               AUTOPTR1L = LSB(pReportDscr);
 169   2      
 170   2               for(i=0;i<length;i++)
 171   2                  EP0BUF[i]=XAUTODAT1;
 172   2      
 173   2               EP0BCL = length;
 174   2               return (FALSE);
 175   2                      default:
 176   2                              return(TRUE);
 177   2              }
 178   1      }
