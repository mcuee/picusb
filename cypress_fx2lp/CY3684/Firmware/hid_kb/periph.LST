  62          //-----------------------------------------------------------------------------
  63          // Task Dispatcher hooks
  64          //   The following hooks are called by the task dispatcher.
  65          //-----------------------------------------------------------------------------
  66          
  67          void TD_Init(void)             // Called once at startup
  68          {
  69   1         leds = 0xFF;
  70   1         oldbuttons = 0xFF;
  71   1      
  72   1         EP1OUTCFG = 0xB0;       // valid, interrupt
  73   1         EP1INCFG = 0XB0;        // valid, interrupt
  74   1      
  75   1         EP2CFG = EP4CFG = EP6CFG = EP8CFG = 0;   // disable unused endpoints
  76   1      
  77   1              EZUSB_InitI2C();                        // Initialize EZ-USB I2C controller
  78   1      
  79   1      
  80   1      }
  81          
  82          void TD_Poll(void)             // Called repeatedly while the device is idle
  83          {
  84   1         if( !(EP1INCS & bmEPBUSY) )  // Is the IN1BUF available,
  85   1         {
  86   2            EZUSB_ReadI2C(BTN_ADDR,0x01,&buttons);    // Read button states
  87   2            buttons &= 0x0F;
  88   2            if ((oldbuttons - buttons) != 0)  //Change in button state
  89   2            {
  90   3               if (buttons & 1)       //Shift
  91   3                  EP1INBUF[0] = 0;
  92   3               else
  93   3                  EP1INBUF[0] = 2;
  94   3      
  95   3               if (buttons & 2)       //a
  96   3                  EP1INBUF[2] = 0;
  97   3               else
  98   3                  EP1INBUF[2] = 4;
  99   3      
 100   3               if (buttons & 4)       //b
 101   3                  EP1INBUF[3] = 0;
 102   3               else
 103   3                  EP1INBUF[3] = 5;
 104   3      
 105   3               if (buttons & 8)       //c
 106   3                  EP1INBUF[4] = 0;
 107   3               else
 108   3                  EP1INBUF[4] = 6;
 109   3      
 110   3                              EP1INBUF[1] = 0;
 111   3                              EP1INBC = 5;
 112   3            }
 113   2            oldbuttons = buttons;
 114   2         }
 115   1      
 116   1              if( !(EP1OUTCS & bmEPBUSY) )    // Is there something available
 117   1              {
C51 COMPILER V7.06   PERIPH                                                                06/13/2012 13:36:48 PAGE 3   

 118   2                      leds = 0xFF;                    //Turn all off
 119   2      
 120   2                      if (EP1OUTBUF[0] & 0x02)        //Caps
 121   2                              leds &= 0xBF;
 122   2                      if (EP1OUTBUF[0] & 0x01)        //Scroll
 123   2                              leds &= 0xF7;
 124   2                      if (EP1OUTBUF[0] & 0x04)        //Num
 125   2                              leds &= 0xFE;
 126   2      
 127   2            EZUSB_WriteI2C(LED_ADDR, 0x01, &leds);
 128   2            EZUSB_WaitForEEPROMWrite(LED_ADDR);
 129   2      
 130   2                      EP1OUTBC = 0;                           //Rearm endpoint buffer
 131   2              }
 132   1      }
