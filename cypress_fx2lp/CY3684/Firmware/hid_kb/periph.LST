 273          void ISR_Highspeed(void) interrupt 0
 274          {
 275   1         if (EZUSB_HIGHSPEED())
 276   1         {
 277   2            pConfigDscr = pHighSpeedConfigDscr;
 278   2            ((CONFIGDSCR xdata *) pConfigDscr)->type = CONFIG_DSCR;
