 314          BOOL DR_VendorCmnd(void)
 315          {
 316   1        BYTE tmp;
 317   1        
 318   1        switch (SETUPDAT[1])
 319   1        {
 320   2           case VR_NAKALL_ON:
 321   2              tmp = FIFORESET;
 322   2              tmp |= bmNAKALL;      
 323   2              SYNCDELAY;                    
 324   2              FIFORESET = tmp;
 325   2              break;
 326   2              case VR_IMT4_TRIGGER:
 327   2                              *EP0BUF = VR_IMT4_TRIGGER; // Fail
 328   2                              EP0BCH = 0;
 329   2                              EP0BCL = 1; // Arm endpoint with # bytes to transfer
 330   2                              EXIF |= 0x40;  //Trigger  external  interrupt in SW
 331   2                              break;
 332   2           case VR_NAKALL_OFF:
 333   2              tmp = FIFORESET;
 334   2              tmp &= ~bmNAKALL;      
 335   2              SYNCDELAY;                    
 336   2              FIFORESET = tmp;
 337   2              break;
 338   2           default:
 339   2              return(TRUE);
 340   2        }
 341   1      
 342   1        return(FALSE);
 343   1      }
