 215          void TD_Poll(void)              // Called repeatedly while the device is idle
 216          {
 217   1         
 218   1        WORD i;
 219   1        WORD count;
 220   1          INTSETUP &= ~bmAV4EN;     // Disable INT4 autovectoring so that we use  the external INT4
 221   1               
 222   1      
 223   1      if(!(EP2468STAT & bmEP4EMPTY))
 224   1        { // check EP4 EMPTY(busy) bit in EP2468STAT (SFR), core set's this bit when FIFO is empty
 225   2           if(!(EP2468STAT & bmEP8FULL))
 226   2           {  // check EP8 FULL(busy) bit in EP2468STAT (SFR), core set's this bit when FIFO is full
 227   3              APTR1H = MSB( &EP4FIFOBUF );
 228   3              APTR1L = LSB( &EP4FIFOBUF );
 229   3      
 230   3              AUTOPTRH2 = MSB( &EP8FIFOBUF );
C51 COMPILER V7.06   INTR                                                                  06/13/2012 13:36:22 PAGE 5   

 231   3              AUTOPTRL2 = LSB( &EP8FIFOBUF );
 232   3      
 233   3              count = (EP4BCH << 8) + EP4BCL;
 234   3              //EXTAUTODAT2 = EXTAUTODAT1+1;
 235   3              // loop EP4OUT buffer data to EP8IN
 236   3              for( i = 0x0000; i < count; i++ )
 237   3              {
 238   4                 // setup to transfer EP4OUT buffer to EP8IN buffer using AUTOPOINTER(s)
 239   4                 EXTAUTODAT2 = EXTAUTODAT1;
 240   4              }
 241   3              
 242   3              EP8BCH = EP4BCH;  
 243   3              SYNCDELAY;  
 244   3              EP8BCL = EP4BCL;        // arm EP8IN
 245   3              SYNCDELAY;                    
 246   3              EP4BCL = 0x80;          // re(arm) EP4OUT
 247   3           }
 248   2        }
 249   1      }
