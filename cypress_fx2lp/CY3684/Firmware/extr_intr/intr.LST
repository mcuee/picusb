 454          void ISR_Ibn(void) interrupt 0
 455          {
 456   1         int i;
 457   1         int byteCount;
 458   1         // disable IBN for all endpoints
 459   1        // IBNIE = 0x00;
 460   1         // clear the global USB IRQ
 461   1         EZUSB_IRQ_CLEAR();         
 462   1      
 463   1         // Find the EP with its IBN bit set
 464   1        /* for (i=0;i<8;i++)
 465   1         {
 466   1            if (IBNIRQ & (1 << i))
 467   1            {
 468   1               IbnFlag |= (1 << i);       // set the appropriate IBN flag bit
 469   1               IBNIRQ |= (1 << i);        // clear the IBN IRQ for this endpoint
 470   1            }
 471   1         }*/
 472   1      
 473   1       
 474   1        // if there is new data in EP2FIFOBUF and the IBN flag for EP6 has been set, then copy
 475   1        // the data from EP2 to EP6
 476   1        if(!(EP2468STAT & bmEP2EMPTY) )//&& (IbnFlag & bmEP6IBN) 
 477   1        {
 478   2           APTR1H = MSB( &EP2FIFOBUF );
C51 COMPILER V7.06   INTR                                                                  06/13/2012 13:36:22 PAGE 9   

 479   2           APTR1L = LSB( &EP2FIFOBUF );
 480   2      
 481   2           AUTOPTRH2 = MSB( &EP6FIFOBUF );
 482   2           AUTOPTRL2 = LSB( &EP6FIFOBUF );
 483   2      
 484   2           byteCount = (EP2BCH << 8) + EP2BCL;
 485   2          
 486   2           EXTAUTODAT2 = EXTAUTODAT1+1;
 487   2      
 488   2           for( i = 0x0001; i < byteCount; i++ )
 489   2           {
 490   3              EXTAUTODAT2 = EXTAUTODAT1;
 491   3           }
 492   2      
 493   2           EP6BCH = EP2BCH;  
 494   2           SYNCDELAY;  
 495   2           EP6BCL = EP2BCL;           // arm EP6IN
 496   2      
 497   2           //IbnFlag &= ~bmEP6IBN;      // clear the IBN flag
 498   2           IBNIRQ = bmEP6IBN;         // clear the IBN IRQ
 499   2           IBNIE |= bmEP6IBN;         // enable the IBN IRQ
 500   2      
 501   2           SYNCDELAY;                        
 502   2           EP2BCL = 0x80;             // re(arm) EP2OUT
 503   2        }
 504   1      
 505   1        // if there is new data in EP4FIFOBUF and the IBN flag for EP8 has been set, then copy
 506   1        // the data from EP2 to EP6
 507   1        
 508   1        NAKIRQ |= bmBIT0;          // clear the global IBN IRQ
 509   1      
 510   1         // re-enable IBN interrupt for any endpoints that don't already have
 511   1         // an IBN pending in IbnFlag
 512   1         IBNIE = bmEP6IBN ;
 513   1      }
