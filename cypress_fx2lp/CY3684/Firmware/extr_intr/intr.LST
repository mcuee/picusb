  95          void TD_Init(void)             // Called once at startup              
  96          {
  97   1         CPUCS = ((CPUCS & ~bmCLKSPD) | bmCLKSPD1) ;
  98   1      
  99   1         // set the slave FIFO interface to 48MHz
 100   1         IFCONFIG |= 0x40;
 101   1        
 102   1       
 103   1      
 104   1        // Registers which require a synchronization delay, see section 15.14
 105   1        // FIFORESET        FIFOPINPOLAR
 106   1        // INPKTEND         OUTPKTEND
 107   1        // EPxBCH:L         REVCTL
 108   1        // GPIFTCB3         GPIFTCB2
 109   1        // GPIFTCB1         GPIFTCB0
 110   1        // EPxFIFOPFH:L     EPxAUTOINLENH:L
 111   1        // EPxFIFOCFG       EPxGPIFFLGSEL
 112   1        // PINFLAGSxx       EPxFIFOIRQ
 113   1        // EPxFIFOIE        GPIFIRQ
C51 COMPILER V7.06   INTR                                                                  06/13/2012 13:36:22 PAGE 3   

 114   1        // GPIFIE           GPIFADRH:L
 115   1        // UDMACRCH:L       EPxGPIFTRIG
 116   1        // GPIFTRIG
 117   1        
 118   1        // Note: The pre-REVE EPxGPIFTCH/L register are affected, as well...
 119   1        //      ...these have been replaced by GPIFTC[B3:B0] registers
 120   1      
 121   1        // default: all endpoints have their VALID bit set
 122   1        // default: TYPE1 = 1 and TYPE0 = 0 --> BULK  
 123   1        // default: EP2 and EP4 DIR bits are 0 (OUT direction)
 124   1        // default: EP6 and EP8 DIR bits are 1 (IN direction)
 125   1        // default: EP2, EP4, EP6, and EP8 are double buffered
 126   1      
 127   1        // we are just using the default values, yes this is not necessary...
 128   1        EP1OUTCFG = 0xA0;
 129   1        EP1INCFG = 0xA0;
 130   1        SYNCDELAY;                    // see TRM section 15.14
 131   1        EP2CFG = 0xA2;
 132   1        SYNCDELAY;                    
 133   1        EP4CFG = 0xA0;
 134   1        SYNCDELAY;                    
 135   1        EP6CFG = 0xE2;
 136   1        SYNCDELAY;                    
 137   1        EP8CFG = 0xE0;
 138   1      
 139   1        // out endpoints do not come up armed.  Arm EP1, EP2 and EP4 OUT  endpoints
 140   1         EP1OUTBC = 0x40;                             // arm the EP1 OUT endpoint by writing to the byte count
 141   1        // since the defaults are double buffered we must write dummy byte counts twice
 142   1        SYNCDELAY;                    
 143   1        EP2BCL = 0x80;                // arm EP2OUT by writing byte count w/skip.
 144   1        SYNCDELAY;                    
 145   1        EP2BCL = 0x80;
 146   1        SYNCDELAY;                    
 147   1        EP4BCL = 0x80;                // arm EP4OUT by writing byte count w/skip.
 148   1        SYNCDELAY;                    
 149   1        EP4BCL = 0x80;    
 150   1      
 151   1       
 152   1        
 153   1        
 154   1       /************************************Enable Endpoint Interrupt for EP1IN and EP1OUT**********************
             -*********************/
 155   1      
 156   1                      EPIE |= bmBIT3 ; // Enable EP1 OUT Endpoint interrupts
 157   1                      EPIE |= bmBIT2; // Enable  EP1 IN  Endpoint interrupts
 158   1        
 159   1        // enable dual autopointer feature
 160   1        AUTOPTRSETUP |= 0x01;
 161   1      
 162   1        Rwuen = TRUE;                 // Enable remote-wakeup
 163   1                                                                      // Configure  for  external interrupts
 164   1      
 165   1      /************************************************************Port C configuration*************************
             -**/
 166   1      
 167   1              PORTCCFG = 0x00;            // PORTC is is configured as an I/O, alternately it can output the lower addr
             -ess of enabled GPIF address pins
 168   1              OEC  = 0xFF;                // PORTC is an output
 169   1              IOC = 0xFF;                 // Initialize PORTC to all LOW
 170   1      
 171   1      /************************************************************External Interrupt***************************
             -/
C51 COMPILER V7.06   INTR                                                                  06/13/2012 13:36:22 PAGE 4   

 172   1      
 173   1      //INT0# and INT1#
 174   1      
 175   1              PORTACFG = 0x03;            // PA0 and PA1 are pins for INT0 and INT1 respectively.
 176   1              TCON |= 0x05;               // INT0 and INT1 are configured as Edge triggered interrupts. 
 177   1      
 178   1      //INT4
 179   1      
 180   1              INTSETUP &= ~0x02;          // If INTSETUP.1=0,then INT4 is supplied by the pin.Else, the interrupt is su
             -pplied internally FIFO/GPIF sources.
 181   1      
 182   1      //INT5#  is a dedicated  pin , available in the 100 amd 128 pin packages.
 183   1      
 184   1      //INT6# 
 185   1      
 186   1              PORTECFG = 0x20;            // PE5  is  INT6 
 187   1              OEE &= ~0x20;
 188   1              
 189   1      //Enable  External Interrupts
 190   1              EIE |= 0x1C;                    // Enable External Interrupts 4, 5 and 6
 191   1          IE  |= 0x05;                            // Enable External Interrupts 0 and 1       
 192   1              
 193   1      //Clear  Flags
 194   1          EXIF &= 0xBF;                       // Clear INT4 EXIF.6  Flag
 195   1              EXIF &= 0x7F;                           // Clear INT5 EXIF.7  Flag
 196   1              EICON &= 0xF7;                  // Clear INT6 EICON.3  Flag
 197   1              EA   = 1;                                   // Enable Global Interrupt
 198   1      
 199   1         /*********************************************Enable the IBN interrupt for EP2 ************************
             -*************************************/
 200   1      
 201   1          // NAKIRQ = bmBIT0;              // clear the global IBN IRQ
 202   1               NAKIE |= bmBIT0;              // enable the global IBN IRQ
 203   1      
 204   1       // IbnFlag = 0x00;               // clear our IBN flag
 205   1        //IBNIRQ = 0xFF;                // clear any pending IBN IRQ
 206   1        IBNIE |= bmEP6IBN ; // enable the IBN interrupt for EP6  
 207   1        NAKIRQ |= ~bmIBN;                   // clear any pending PING-NAK IRQ
 208   1      
 209   1         /********************Enable the PING-NAK interrupt for EP4*********************************************
             -**************************************/
 210   1      
 211   1        NAKIE |=  bmEP4PING;     // enable the PING-NAK interrupt for  EP4
 212   1      }
