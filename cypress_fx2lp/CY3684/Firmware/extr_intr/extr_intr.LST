 441          void ISR_Ibn(void) interrupt 0
 442          {
 443   1         int i;
 444   1         int byteCount;
 445   1         // disable IBN for all endpoints
 446   1         IBNIE = 0x00;
 447   1      
 448   1         EZUSB_IRQ_CLEAR();         // clear the global USB IRQ
 449   1      
 450   1         // Find the EP with its IBN bit set
 451   1         for (i=0;i<8;i++)
 452   1         {
 453   2            if (IBNIRQ & (1 << i))
 454   2            {
 455   3               IbnFlag |= (1 << i);       // set the appropriate IBN flag bit
 456   3               IBNIRQ |= (1 << i);        // clear the IBN IRQ for this endpoint
 457   3            }
 458   2         }
 459   1      
 460   1       
 461   1        // if there is new data in EP2FIFOBUF and the IBN flag for EP6 has been set, then copy
 462   1        // the data from EP2 to EP6
 463   1        if(!(EP2468STAT & bmEP2EMPTY) && (IbnFlag & bmEP6IBN) )
 464   1        {
 465   2           APTR1H = MSB( &EP2FIFOBUF );
 466   2           APTR1L = LSB( &EP2FIFOBUF );
 467   2      
 468   2           AUTOPTRH2 = MSB( &EP6FIFOBUF );
 469   2           AUTOPTRL2 = LSB( &EP6FIFOBUF );
 470   2      
 471   2           byteCount = (EP2BCH << 8) + EP2BCL;
 472   2      
 473   2           for( i = 0x0000; i < byteCount; i++ )
 474   2           {
 475   3              EXTAUTODAT2 = EXTAUTODAT1;
 476   3           }
 477   2      
 478   2           EP6BCH = EP2BCH;  
 479   2           SYNCDELAY;  
 480   2           EP6BCL = EP2BCL;           // arm EP6IN
C51 COMPILER V7.06   EXTR_INTR                                                             03/25/2012 06:55:21 PAGE 9   

 481   2      
 482   2           IbnFlag &= ~bmEP6IBN;      // clear the IBN flag
 483   2           IBNIRQ = bmEP6IBN;         // clear the IBN IRQ
 484   2           IBNIE |= bmEP6IBN;         // enable the IBN IRQ
 485   2      
 486   2           SYNCDELAY;                        
 487   2           EP2BCL = 0x80;             // re(arm) EP2OUT
 488   2        }
 489   1      
 490   1        // if there is new data in EP4FIFOBUF and the IBN flag for EP8 has been set, then copy
 491   1        // the data from EP2 to EP6
 492   1        
 493   1        NAKIRQ |= bmBIT0;          // clear the global IBN IRQ
 494   1      
 495   1         // re-enable IBN interrupt for any endpoints that don't already have
 496   1         // an IBN pending in IbnFlag
 497   1         IBNIE = (bmEP6IBN | bmEP8IBN) & ~IbnFlag;
 498   1      }
