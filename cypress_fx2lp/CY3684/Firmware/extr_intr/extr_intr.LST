 206          void TD_Poll(void)              // Called repeatedly while the device is idle
 207          {   
 208   1        WORD i;
 209   1        WORD count;
 210   1          INTSETUP &= ~bmAV4EN;     // Disable INT4 autovectoring so that we use  the external INT4
 211   1      if(!(EP2468STAT & bmEP4EMPTY))
 212   1        { // check EP4 EMPTY(busy) bit in EP2468STAT (SFR), core set's this bit when FIFO is empty
 213   2           if(!(EP2468STAT & bmEP8FULL))
 214   2           {  // check EP8 FULL(busy) bit in EP2468STAT (SFR), core set's this bit when FIFO is full
 215   3              APTR1H = MSB( &EP4FIFOBUF );
 216   3              APTR1L = LSB( &EP4FIFOBUF );
 217   3      
 218   3              AUTOPTRH2 = MSB( &EP8FIFOBUF );
 219   3              AUTOPTRL2 = LSB( &EP8FIFOBUF );
 220   3      
 221   3              count = (EP4BCH << 8) + EP4BCL;
 222   3      
 223   3              // loop EP4OUT buffer data to EP8IN
 224   3              for( i = 0x0000; i < count; i++ )
 225   3              {
 226   4                 // setup to transfer EP4OUT buffer to EP8IN buffer using AUTOPOINTER(s)
 227   4                 EXTAUTODAT2 = EXTAUTODAT1;
 228   4              }
 229   3              
 230   3              EP8BCH = EP4BCH;  
 231   3              SYNCDELAY;  
 232   3              EP8BCL = EP4BCL;        // arm EP8IN
C51 COMPILER V7.06   EXTR_INTR                                                             03/25/2012 06:55:21 PAGE 5   

 233   3              SYNCDELAY;                    
 234   3              EP4BCL = 0x80;          // re(arm) EP4OUT
 235   3           }
 236   2        }
 237   1      }
