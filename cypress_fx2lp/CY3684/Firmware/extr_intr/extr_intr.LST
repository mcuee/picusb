 302          BOOL DR_VendorCmnd(void)
 303          {
 304   1        BYTE tmp;
 305   1        
 306   1        switch (SETUPDAT[1])
 307   1        {
 308   2           case VR_NAKALL_ON:
 309   2              tmp = FIFORESET;
 310   2              tmp |= bmNAKALL;      
 311   2              SYNCDELAY;                    
 312   2              FIFORESET = tmp;
 313   2              break;
 314   2              case VR_IMT4_TRIGGER:
 315   2                              *EP0BUF = VR_IMT4_TRIGGER; // Fail
 316   2                              EP0BCH = 0;
 317   2                              EP0BCL = 1; // Arm endpoint with # bytes to transfer
 318   2                              EXIF |= 0x40;  //Trigger  external  interrupt in SW
 319   2                              break;
 320   2           case VR_NAKALL_OFF:
 321   2              tmp = FIFORESET;
 322   2              tmp &= ~bmNAKALL;      
 323   2              SYNCDELAY;                    
 324   2              FIFORESET = tmp;
 325   2              break;
 326   2           default:
 327   2              return(TRUE);
 328   2        }
 329   1      
 330   1        return(FALSE);
 331   1      }
