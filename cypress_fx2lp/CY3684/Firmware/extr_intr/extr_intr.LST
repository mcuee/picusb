  95          void TD_Init(void)             // Called once at startup              
  96          {
  97   1         CPUCS = ((CPUCS & ~bmCLKSPD) | bmCLKSPD1) ;
  98   1      
  99   1         // set the slave FIFO interface to 48MHz
 100   1         IFCONFIG |= 0x40;
 101   1      
 102   1        // Registers which require a synchronization delay, see section 15.14
 103   1        // FIFORESET        FIFOPINPOLAR
 104   1        // INPKTEND         OUTPKTEND
 105   1        // EPxBCH:L         REVCTL
 106   1        // GPIFTCB3         GPIFTCB2
 107   1        // GPIFTCB1         GPIFTCB0
 108   1        // EPxFIFOPFH:L     EPxAUTOINLENH:L
 109   1        // EPxFIFOCFG       EPxGPIFFLGSEL
 110   1        // PINFLAGSxx       EPxFIFOIRQ
 111   1        // EPxFIFOIE        GPIFIRQ
 112   1        // GPIFIE           GPIFADRH:L
 113   1        // UDMACRCH:L       EPxGPIFTRIG
C51 COMPILER V7.06   EXTR_INTR                                                             03/25/2012 06:55:21 PAGE 3   

 114   1        // GPIFTRIG
 115   1        
 116   1        // Note: The pre-REVE EPxGPIFTCH/L register are affected, as well...
 117   1        //      ...these have been replaced by GPIFTC[B3:B0] registers
 118   1      
 119   1        // default: all endpoints have their VALID bit set
 120   1        // default: TYPE1 = 1 and TYPE0 = 0 --> BULK  
 121   1        // default: EP2 and EP4 DIR bits are 0 (OUT direction)
 122   1        // default: EP6 and EP8 DIR bits are 1 (IN direction)
 123   1        // default: EP2, EP4, EP6, and EP8 are double buffered
 124   1      
 125   1        // we are just using the default values, yes this is not necessary...
 126   1        EP1OUTCFG = 0xA0;
 127   1        EP1INCFG = 0xA0;
 128   1        SYNCDELAY;                    // see TRM section 15.14
 129   1        EP2CFG = 0xA2;
 130   1        SYNCDELAY;                    
 131   1        EP4CFG = 0xA0;
 132   1        SYNCDELAY;                    
 133   1        EP6CFG = 0xE2;
 134   1        SYNCDELAY;                    
 135   1        EP8CFG = 0xE0;
 136   1      
 137   1        // out endpoints do not come up armed.  Arm EP1, EP2 and EP4 OUT  endpoints
 138   1         EP1OUTBC = 0x40;                             // arm the EP1 OUT endpoint by writing to the byte count
 139   1        // since the defaults are double buffered we must write dummy byte counts twice
 140   1        SYNCDELAY;                    
 141   1        EP2BCL = 0x80;                // arm EP2OUT by writing byte count w/skip.
 142   1        SYNCDELAY;                    
 143   1        EP2BCL = 0x80;
 144   1        SYNCDELAY;                    
 145   1        EP4BCL = 0x80;                // arm EP4OUT by writing byte count w/skip.
 146   1        SYNCDELAY;                    
 147   1        EP4BCL = 0x80;    
 148   1      
 149   1       
 150   1        
 151   1        
 152   1       /************************************Endpoint Interrupt*******************************************/
 153   1      
 154   1      EPIE |= bmBIT3 ; // Enable EP1 OUT Endpoint interrupts
 155   1      EPIE |= bmBIT2; // Enable  EP1 IN  Endpoint interrupts
 156   1        
 157   1        // enable dual autopointer feature
 158   1        
 159   1        AUTOPTRSETUP |= 0x01;
 160   1      
 161   1        Rwuen = TRUE;                 // Enable remote-wakeup
 162   1      // Configure  for  external interrupts
 163   1      /************************************************************External Interrupt***************************
             -/
 164   1              PORTCCFG = 0x00;            // PORTC is is configured as an I/O, alternately it can output the lower addr
             -ess of enabled GPIF address pins
 165   1              OEC  = 0xFF;                // PORTC is an output
 166   1              IOC = 0xFF;                 // Initialize PORTC to all LOW
 167   1      
 168   1      //INT0# and INT1#
 169   1      
 170   1              PORTACFG = 0x03;            // PA0 and PA1 are pins for INT0 and INT1 respectively.
 171   1              TCON |= 0x05;               // INT0 and INT1 are configured as Edge triggered interrupts. 
 172   1      
 173   1      //INT4
C51 COMPILER V7.06   EXTR_INTR                                                             03/25/2012 06:55:21 PAGE 4   

 174   1      
 175   1              INTSETUP &= ~0x02;          // If INTSETUP.1=0,then INT4 is supplied by the pin.Else, the interrupt is su
             -pplied internally FIFO/GPIF sources.
 176   1      
 177   1      //INT5#  is a dedicated  pin , available in the 100 amd 128 pin packages.
 178   1      
 179   1      //INT6# 
 180   1      
 181   1              PORTECFG = 0x20;            // PE5  is  INT6 
 182   1              OEE &= ~0x20;
 183   1              
 184   1      //Enable  External Interrupts
 185   1              EIE |= 0x1C;                    // Enable External Interrupts 4, 5 and 6
 186   1          IE  |= 0x05;                            // Enable External Interrupts 0 and 1       
 187   1              
 188   1      //Clear  Flags
 189   1          EXIF &= 0xBF;                       // Clear INT4 EXIF.6  Flag
 190   1              EXIF &= 0x7F;                           // Clear INT5 EXIF.7  Flag
 191   1              EICON &= 0xF7;                  // Clear INT6 EICON.3  Flag
 192   1              EA   = 1;                                   // Enable Global Interrupt
 193   1         /*********************************************IBN******************************************************
             -*******/
 194   1           NAKIRQ = bmBIT0;              // clear the global IBN IRQ
 195   1        NAKIE |= bmBIT0;              // enable the global IBN IRQ
 196   1      
 197   1        IbnFlag = 0x00;               // clear our IBN flag
 198   1        IBNIRQ = 0xFF;                // clear any pending IBN IRQ
 199   1        IBNIE |= bmEP6IBN | bmEP8IBN; // enable the IBN interrupt for EP6 and EP8
 200   1         NAKIRQ |= ~bmIBN;                   // clear any pending PING-NAK IRQ
 201   1         /********************PING******************************************************************************
             -*****/
 202   1        NAKIE |=  bmEP4PING;     // enable the PING-NAK interrupt for EP2 and EP4
 203   1      }
